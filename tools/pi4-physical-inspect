#!/bin/sh
## @file
## @brief Collect physical Pi platform evidence without changing hardware or services.
## @details Run through SSH using sh -s -- rt or nonrt. No module loading,
## pin changes, bus probing, mounts, reboot, or stress workloads are performed.
## A zero exit status covers the explicit basic checks, not full G1 acceptance.

set -u
qtooth_failures=0
qtooth_profile=${1:-rt}
case "$qtooth_profile" in
    rt)
        qtooth_config=1a0ff6c3a53747dd9de9779d07b650a6c3f9f755d54393724521bd9e0edbbc85
        qtooth_preempt=preempt_rt
        ;;
    nonrt)
        qtooth_config=f76800a867ead8e75b1e2f5dff2a1d6a50d49355aba81a252b14d99ad317e905
        qtooth_preempt=preempt
        ;;
    *) printf 'Usage: sh pi4-physical-inspect [rt|nonrt]\n' >&2; exit 2 ;;
esac
qtooth_release=6.18.33-v8

## @brief Label a group of related observations.
## @param $1 Section label.
## @return Zero after printing the label.
section() { printf '\n=== %s ===\n' "$1"; }

## @brief Record a command and its output, including failure status.
## @param ... Executable and arguments to inspect.
## @return Zero so unavailable observations do not stop collection.
observe() {
    printf '\nCOMMAND:'
    printf ' %s' "$@"
    printf '\n'
    if command -v timeout >/dev/null 2>&1; then
        timeout -k 2 10 "$@"
        qtooth_status=$?
    else
        "$@" &
        qtooth_observed_pid=$!
        (
            qtooth_sleep_pid=
            trap 'if [ -n "$qtooth_sleep_pid" ]; then kill "$qtooth_sleep_pid" 2>/dev/null || :; wait "$qtooth_sleep_pid" 2>/dev/null || :; fi; exit 0' TERM INT HUP
            sleep 10 &
            qtooth_sleep_pid=$!
            wait "$qtooth_sleep_pid" || exit 0
            kill -TERM "$qtooth_observed_pid" 2>/dev/null || exit 0
            sleep 2 &
            qtooth_sleep_pid=$!
            wait "$qtooth_sleep_pid" || exit 0
            kill -KILL "$qtooth_observed_pid" 2>/dev/null || :
        ) &
        qtooth_watchdog_pid=$!
        wait "$qtooth_observed_pid"
        qtooth_status=$?
        kill -TERM "$qtooth_watchdog_pid" 2>/dev/null || :
        wait "$qtooth_watchdog_pid" 2>/dev/null || :
    fi
    printf 'COMMAND_EXIT=%s\n' "$qtooth_status"
}

## @brief Record an explicit basic acceptance assertion and retain failures.
## @param ... Command implementing the assertion.
## @return Zero so remaining checks can execute.
check() {
    if "$@"; then
        printf 'CHECK_PASS:'
    else
        qtooth_failures=$((qtooth_failures + 1))
        printf 'CHECK_FAIL:'
    fi
    printf ' %s' "$@"
    printf '\n'
}

## @brief Record an available sysfs or boot file, labeling missing observations.
## @param $1 File path to read without modifying it.
## @return Zero after recording presence or absence.
show_file() {
    if [ -r "$1" ]; then
        printf '\nFILE: %s\n' "$1"
        tr '\000' '\n' < "$1"
        printf '\n'
    else
        printf 'UNAVAILABLE: %s\n' "$1"
    fi
}

## @brief Resolve a device-tree alias and inspect activation and requested clock.
## @param $1 Device-tree alias such as i2c1 or spi0.
## @return Zero after recording observed metadata; no pin configuration is changed.
dt_alias() {
    qtooth_alias=/sys/firmware/devicetree/base/aliases/$1
    if [ ! -r "$qtooth_alias" ]; then
        printf 'UNAVAILABLE_DT_ALIAS: %s\n' "$1"
        return 0
    fi
    qtooth_node=/sys/firmware/devicetree/base$(tr -d '\000' < "$qtooth_alias")
    printf '\nDT_ALIAS: %s -> %s\n' "$1" "$qtooth_node"
    if [ -r "$qtooth_node/status" ]; then
        tr '\000' '\n' < "$qtooth_node/status"
    else
        printf 'No status property (default enabled if node/parents are enabled).\n'
    fi
    if [ -r "$qtooth_node/clock-frequency" ]; then
        printf 'Requested clock-frequency, big-endian octal bytes (first column is offset):\n'
        od -b "$qtooth_node/clock-frequency"
    fi
    for qtooth_child in "$qtooth_node"/spidev@*; do
        [ -d "$qtooth_child" ] || continue
        show_file "$qtooth_child/status"
    done
}

section 'Identity and running kernel'
observe uname -a
printf 'Target wall clock is unverified; intervals require monotonic timestamps.\n'
observe date -u
show_file /proc/sys/kernel/random/boot_id
show_file /proc/uptime
show_file /sys/firmware/devicetree/base/model
observe sh -c "grep -E 'Revision|Model' /proc/cpuinfo"
check test "$(uname -m)" = aarch64
check test "$(uname -r)" = "$qtooth_release"
check test "$(cat /proc/1/comm)" = systemd
qtooth_actual_config=$(zcat /proc/config.gz | sha256sum | cut -d ' ' -f 1)
printf 'RUNNING_CONFIG_SHA256=%s\n' "$qtooth_actual_config"
check test "$qtooth_actual_config" = "$qtooth_config"
observe sh -c "zcat /proc/config.gz | grep -E '^CONFIG_(PREEMPT_RT|BT_LE|I2C_BCM2835|I2C_CHARDEV|SPI_BCM2835|GPIOLIB_IRQCHIP|GPIO_CDEV|CRYPTO_CMAC)='"

section 'Module attribution and clean-boot CMAC'
for qtooth_module in hci_uart cmac i2c_bcm2835 i2c_dev spi_bcm2835; do
    observe modinfo -n "$qtooth_module"
    qtooth_vermagic=$(modinfo -F vermagic "$qtooth_module" 2>/dev/null)
    check test "$qtooth_vermagic" = "$qtooth_release SMP $qtooth_preempt mod_unload modversions aarch64"
done
observe cat /proc/modules
check grep -q '^cmac ' /proc/modules
observe sh -c "grep -A 8 -F 'cmac(aes)' /proc/crypto"
check grep -q -F 'cmac(aes)' /proc/crypto
qtooth_cmac_file=$(modinfo -n cmac 2>/dev/null)
if [ -r "$qtooth_cmac_file" ]; then observe sha256sum "$qtooth_cmac_file"; fi

section 'Service and Bluetooth state'
observe systemctl --failed --no-pager
check systemctl is-active dbus systemd-networkd bluetooth
observe systemctl show bluetooth hciuart -p Id -p ActiveState -p SubState -p ConditionResult -p Result
if [ -d /sys/class/bluetooth/hci0 ] && systemctl is-active --quiet bluetooth; then
    observe bluetoothctl list
    observe bluetoothctl show
else
    printf 'Bluetooth controller/service unavailable; controller queries skipped.\n'
fi
check test -d /sys/class/bluetooth/hci0
observe ssh-keygen -lf /etc/ssh/ssh_host_ecdsa_key.pub

section 'Physical boot and microSD'
show_file /proc/cmdline
show_file /proc/mounts
show_file /proc/partitions
observe df -k
for qtooth_boot in /boot /boot/firmware; do
    for qtooth_file in config.txt cmdline.txt; do
        show_file "$qtooth_boot/$qtooth_file"
    done
    for qtooth_file in config.txt overlays/qtooth-platform-buses.dtbo kernel8.img bcm2711-rpi-4-b.dtb start4.elf fixup4.dat; do
        if [ -r "$qtooth_boot/$qtooth_file" ]; then
            observe sha256sum "$qtooth_boot/$qtooth_file"
        fi
    done
done
show_file /sys/class/block/mmcblk0/device/name
for qtooth_file in /usr/lib/libcrypto.so.3 /usr/libexec/bluetooth/bluetoothd /etc/os-release /etc/systemd/network/20-qtooth-wired.network /etc/ssh/sshd_config.d/10-qtooth-diagnostic.conf; do
    if [ -r "$qtooth_file" ]; then observe sha256sum "$qtooth_file"; fi
done

section 'Ethernet and interface activation'
observe ip -4 address
observe ip -4 route
observe networkctl status --no-pager
dt_alias i2c1
dt_alias spi0
observe sh -c 'ls -l /dev/i2c-* /dev/gpiochip* /sys/bus/i2c/devices /sys/class/spi_master /sys/bus/spi/devices'
for qtooth_device in /sys/bus/platform/devices/*i2c* /sys/bus/platform/devices/*spi*; do
    [ -d "$qtooth_device" ] || continue
    printf '\nPLATFORM_DEVICE: %s\n' "$qtooth_device"
    if [ -L "$qtooth_device/driver" ]; then
        readlink "$qtooth_device/driver"
    else
        printf 'No bound driver.\n'
    fi
done

section 'USB enumeration'
for qtooth_device in /sys/bus/usb/devices/*; do
    [ -r "$qtooth_device/product" ] || continue
    show_file "$qtooth_device/product"
done

section 'Resources, temperature and clocks (inspection snapshots)'
show_file /proc/meminfo
observe systemctl show -p UserspaceTimestampMonotonic -p FinishTimestampMonotonic
for qtooth_file in /sys/class/thermal/thermal_zone*/temp /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor /sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq /sys/devices/system/clocksource/clocksource0/current_clocksource /sys/class/hwmon/hwmon*/name /sys/class/hwmon/hwmon*/in*_lcrit_alarm; do
    [ -r "$qtooth_file" ] && show_file "$qtooth_file"
done
if command -v vcgencmd >/dev/null 2>&1; then
    observe vcgencmd get_throttled
fi

section 'Kernel warnings and retained boot log'
observe journalctl -k -b -p warning --no-pager
observe dmesg
printf '\nBASIC_CHECK_FAILURES=%s\n' "$qtooth_failures"
printf 'Collection complete. Physical interface function, controlled BASE-3 trials and G1 acceptance require separate review.\n'
test "$qtooth_failures" -eq 0
