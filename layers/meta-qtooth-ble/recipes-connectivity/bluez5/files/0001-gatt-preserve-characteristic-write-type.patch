From: QuantumTooth contributors <quantumtooth@example.invalid>
Subject: [PATCH] gatt: preserve characteristic ATT write type for local servers

BlueR 0.17.4 defaults missing WriteValue type metadata to Command. Forward
actual characteristic ATT opcodes so local applications can distinguish
ordinary Requests from Commands and queued writes without guessing.
Descriptor and read metadata remain unchanged. Unknown opcodes omit type.

Upstream-Status: Pending
---
diff --git a/src/gatt-database.c b/src/gatt-database.c
--- a/src/gatt-database.c
+++ b/src/gatt-database.c
@@ -158,6 +158,7 @@
 	unsigned int disconn_id;
 	uint16_t offset;
 	uint8_t link_type;
+	uint8_t opcode;
 	struct gatt_db_attribute *attrib;
 	struct queue *owner_queue;
 	struct iovec data;
@@ -2356,6 +2357,27 @@
 	return op;
 }
 
+/**
+ * @brief Preserve the original characteristic ATT write kind in D-Bus metadata.
+ * @param opcode ATT request, command or queued-write opcode.
+ * @return BlueR write type, or NULL when no supported write opcode is available.
+ */
+static const char *att_write_type(uint8_t opcode)
+{
+	switch (opcode) {
+	case BT_ATT_OP_WRITE_REQ:
+		return "request";
+	case BT_ATT_OP_WRITE_CMD:
+	case BT_ATT_OP_SIGNED_WRITE_CMD:
+		return "command";
+	case BT_ATT_OP_PREP_WRITE_REQ:
+	case BT_ATT_OP_EXEC_WRITE_REQ:
+		return "reliable";
+	default:
+		return NULL;
+	}
+}
+
 static void append_options(DBusMessageIter *iter, void *user_data)
 {
 	struct pending_op *op = user_data;
@@ -2363,6 +2385,7 @@
 	const char *path = device_get_path(device);
 	struct bt_gatt_server *server;
 	const char *link;
+	const char *type = att_write_type(op->opcode);
 	uint16_t mtu;
 
 	switch (op->link_type) {
@@ -2391,6 +2414,8 @@
 	mtu = bt_gatt_server_get_mtu(server);
 
 	dict_append_entry(iter, "mtu", DBUS_TYPE_UINT16, &mtu);
+	if (type)
+		dict_append_entry(iter, "type", DBUS_TYPE_STRING, &type);
 }
 
 static void read_setup_cb(DBusMessageIter *iter, void *user_data)
@@ -2512,7 +2537,8 @@
 					const uint8_t *value, size_t len,
 					uint16_t offset,
 					bool is_characteristic,
-					bool prep_authorize)
+					bool prep_authorize,
+					uint8_t opcode)
 {
 	struct pending_op *op;
 
@@ -2529,6 +2555,7 @@
 	op->link_type = bt_att_get_link_type(att);
 	op->is_characteristic = is_characteristic;
 	op->prep_authorize = prep_authorize;
+	op->opcode = opcode;
 	queue_push_tail(owner_queue, op);
 
 	op->disconn_id = bt_att_register_disconnect(att,
@@ -2546,13 +2573,14 @@
 					const uint8_t *value, size_t len,
 					uint16_t offset,
 					bool is_characteristic,
-					bool prep_authorize)
+					bool prep_authorize,
+					uint8_t opcode)
 {
 	struct pending_op *op;
 
 	op = pending_write_new(att, owner_queue, attrib, id, value, len,
 					offset, is_characteristic,
-					prep_authorize);
+					prep_authorize, opcode);
 
 	if (g_dbus_proxy_method_call(proxy, "WriteValue", write_setup_cb,
 					owner_queue ? write_reply_cb : NULL,
@@ -2846,13 +2874,14 @@
 					struct bt_att *att,
 					struct gatt_db_attribute *attrib,
 					unsigned int id,
-					const uint8_t *value, size_t len)
+					const uint8_t *value, size_t len,
+					uint8_t opcode)
 {
 	struct pending_op *op;
 	bool acquiring = !queue_isempty(chrc->pending_writes);
 
 	op = pending_write_new(att, chrc->pending_writes, attrib, id, value,
-				len, 0, false, false);
+				len, 0, false, false, opcode);
 
 	if (acquiring)
 		return op;
@@ -3201,7 +3230,7 @@
 						desc->req_prep_authorization)
 			send_write(att, attrib, desc->proxy,
 					desc->pending_writes, id, value, len,
-					offset, false, true);
+					offset, false, true, 0);
 		else
 			gatt_db_attribute_write_result(attrib, id, 0);
 
@@ -3212,7 +3241,7 @@
 		desc->prep_authorized = false;
 
 	if (send_write(att, attrib, desc->proxy, desc->pending_writes, id,
-			value, len, offset, false, false))
+			value, len, offset, false, false, 0))
 		return;
 
 fail:
@@ -3333,7 +3362,7 @@
 						chrc->req_prep_authorization)
 			send_write(att, attrib, chrc->proxy, queue,
 					id, value, len, offset,
-					true, true);
+					true, true, opcode);
 		else
 			gatt_db_attribute_write_result(attrib, id, 0);
 
@@ -3355,12 +3384,12 @@
 	}
 
 	if (g_dbus_proxy_get_property(chrc->proxy, "WriteAcquired", &iter)) {
-		if (acquire_write(chrc, att, attrib, id, value, len))
+		if (acquire_write(chrc, att, attrib, id, value, len, opcode))
 			return;
 	}
 
 	if (send_write(att, attrib, chrc->proxy, queue, id, value, len,
-			offset, false, false))
+			offset, false, false, opcode))
 		return;
 
 fail:
