#!/bin/sh
# @file
# @brief Invoke the checksummed wrapper with a local private cache and a configured JDK 21.
set -eu
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
: "${JAVA_HOME:?Set JAVA_HOME to the JDK 21 installation}"
GRADLE_USER_HOME=${GRADLE_USER_HOME:-"$project_dir/../../local/g2-3-react-native-debug-app/gradle"}
export GRADLE_USER_HOME
exec "$JAVA_HOME/bin/java" -classpath "$project_dir/gradle/wrapper/gradle-wrapper.jar" org.gradle.wrapper.GradleWrapperMain "$@"
